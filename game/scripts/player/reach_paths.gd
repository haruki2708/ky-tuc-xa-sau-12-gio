## The point `u` (0..1) of the way along `path`, laid from `from` to `to`.
static func point(path: Array, from: Vector3, to: Vector3, u: float) -> Vector3:
	var chord: Vector3 = to - from
	var length: float = chord.length()
	if path.size() < 2 or length < 0.001:
		return from.lerp(to, clampf(u, 0.0, 1.0))
	var at: float = clampf(u, 0.0, 1.0) * (path.size() - 1)
	var index: int = mini(int(at), path.size() - 2)
	var sample: Vector3 = (path[index] as Vector3).lerp(path[index + 1] as Vector3, at - index)
	var along: Vector3 = chord / length
	var up: Vector3 = Vector3.UP - along * along.dot(Vector3.UP)
	if up.length() < 0.01:
		return from + chord * sample.x
	up = up.normalized()
	# Straight up or down there is no "above the line": the bow fades out as the way steepens.
	var bow: float = length * (1.0 - smoothstep(0.85, 0.98, absf(along.dot(Vector3.UP))))
	return from + chord * sample.x + (up * sample.y + along.cross(up) * sample.z) * bow
