# --- Group call ---------------------------------------------------------------------

func _phone_screen() -> Node:
	return get_parent().get_node_or_null("PhoneScreen") if get_parent() else null


## The call history (T-155 snapshot) and battery ride in GameState flags, so
## they are saved with the checkpoint.
func _store_phone() -> void:
	var screen := _phone_screen()
	if screen != null and screen.has_method("snapshot"):
		GameState.set_flag(&"phone_snapshot", JSON.stringify(screen.snapshot()))
	var phone := _phone_item()
	if phone != null and "battery" in phone:
		GameState.set_flag(&"phone_battery", float(phone.battery))
	GameState.set_flag(&"in_call", _call_answered)


func _restore_phone() -> void:
	var screen := _phone_screen()
	var saved: Variant = GameState.get_flag(&"phone_snapshot", "")
	if screen != null and screen.has_method("restore") and saved is String and not saved.is_empty():
		var data: Variant = JSON.parse_string(saved)
		if data is Dictionary:
			screen.restore(data)
			# Keep the phone in Trung's hand in step with the restored screen.
			var phone := _phone_item()
			if phone != null and phone.has_method("set_raised"):
				phone.set_raised(data.get("raised", false) == true)
	if GameState.has_flag(&"phone_battery"):
		_set_battery(float(GameState.get_flag(&"phone_battery", 100.0)))
	_call_answered = GameState.get_flag(&"in_call", false) == true
	_set_in_call(_call_answered)


func _incoming_call() -> void:
	_call_answered = false
	for ring in 4:
		EventBus.phone_call_incoming.emit(&"stranger_call")
		await _wait_until(func() -> bool: return _call_answered, 20.0)
		if _call_answered:
			break
	# Without a phone screen (T-155) there is no way to answer: carry on.
	_call_answered = true
	_set_in_call(true)


## One spoken line of the group call (MessageData chat_ch1_<id>). Lane E plays
## its voice and lane D shows it; the wait estimates the spoken length.
func _line(id: String) -> void:
	var message_id := StringName("chat_ch1_" + id)
	var data := MessageData.load_by_id(message_id)
	if data == null:
		push_warning("Chapter1Director: missing message " + message_id)
		return
	EventBus.phone_message_received.emit(message_id)
	var seconds := _voice_seconds(data.text_key, "CHAT_CH1_")
	# Lane D's phone screen (T-155) subtitles every spoken line itself.
	if _phone_screen() == null:
		_say(data.text_key, seconds)
	await _wait(seconds + 0.4)


## Offers Trung's replies; returns the picked index (0-based). Time out or no
## phone screen picks the first. The reply then appears in the call.
func _choice(id: StringName, count: int) -> int:
	var keys := PackedStringArray()
	for n in range(1, count + 1):
		keys.append("CHOICE_CH1_%s_%d" % [String(id).to_upper(), n])
	_choice_id = id
	_choice_index = -2
	EventBus.chat_choice_requested.emit(id, keys)
	await _wait_until(func() -> bool: return _choice_index != -2, choice_seconds)
	var picked := clampi(_choice_index, 0, count - 1)
	_choice_id = &""
	EventBus.phone_message_received.emit(StringName("choice_ch1_%s_%d" % [id, picked + 1]))
	GameState.set_flag(StringName("ch1_choice_" + String(id)), picked)
	await _wait(1.2)
	return picked


func _on_choice_made(choice_id: StringName, index: int) -> void:
	if choice_id == _choice_id:
		_choice_index = index


func _member_dies(member: StringName, where: Vector3) -> void:
	EventBus.chat_member_changed.emit(member, &"dead")
	_screams(where, 1, 0.0)


# --- Manager -------------------------------------------------------------------------

## The manager somewhere else in the building: only his blade is heard (T-158).
func _manager_far(where: Vector3) -> void:
	var audio := _manager_audio()
	if audio != null and audio.has_method("place_at"):
		audio.place_at(where)
		if audio.has_method("play_drag"):
			audio.play_drag(true)


func _manager_line(key: String, manager: Node = null) -> void:
	var seconds := _spoken_seconds(key)
	var audio := _manager_audio()
	if manager != null and manager.has_method("ask"):
		manager.ask(key)
	elif audio != null and audio.has_method("say"):
		# The rig plays the voice (T-159) or shows the subtitle itself.
		seconds = maxf(float(audio.say(key)), 0.5)
	else:
		_say(key, seconds)
	await _wait(seconds + 0.5)


func _manager_audio() -> Node3D:
	return get_tree().get_first_node_in_group(&"manager_audio") as Node3D


func _spawn_manager() -> Node3D:
	var audio := _manager_audio()
	if audio != null:
		audio.place_at(DOOR_SPOT)
	if not ResourceLoader.exists(MANAGER_SCENE):
		return null
	var manager := load(MANAGER_SCENE).instantiate() as Node3D
	if manager == null:
		return null
	manager.name = "Manager"
	manager.set("player", _player)
	manager.set("listen_seconds", MANAGER_LISTEN_SECONDS)
	manager.set("look_target", _bunks.get(TRUNG_BED))
	if ResourceLoader.exists(MANAGER_BODY):
		manager.set("body_scene", load(MANAGER_BODY))
	add_child(manager)
	manager.global_position = DOOR_SPOT
	if manager.has_signal("slashed"):
		manager.slashed.connect(func(_target: Node3D) -> void: _slash_progress())
	return manager


var _slash_cuts: int = 0


func _slash_progress() -> void:
	_slash_cuts += 1
	_set_bed_slashed(minf(float(_slash_cuts) / 6.0, 1.0))


## The actor moves in real time; its waits are not scaled (tests speed up only
## the director's own beats).
func _manager_walk(manager: Node3D, to: Vector3, via: PackedVector3Array = PackedVector3Array()) -> void:
	if manager == null or not manager.has_method("walk_to"):
		var audio := _manager_audio()
		if audio != null:
			audio.place_at(to)
		await _wait(2.5)
		return
	manager.walk_to(to, via)
	await _with_timeout(manager.arrived, 15.0, false)


## Asks one line and returns whether he heard anything in the silence after.
func _manager_ask(manager: Node3D, key: String) -> bool:
	if manager != null and manager.has_method("ask") and manager.has_signal("answered"):
		var result := [false, false]
		var on_answer := func(heard: bool) -> void:
			result[0] = true
			result[1] = heard
		manager.answered.connect(on_answer, CONNECT_ONE_SHOT)
		manager.ask(key)
		# He listens once the question is out (T-152): mark that moment.
		await _wait_until(func() -> bool: return result[0], _voice_seconds(key, "MGR_CH1_"), false)
		GameState.set_segment(&"r2_listen")
		await _wait_until(func() -> bool: return result[0] or _bed == 0, 30.0, false)
		if manager.answered.is_connected(on_answer):
			manager.answered.disconnect(on_answer)
		return result[1]
	# Core stand-in: the rig speaks, then the director listens.
	await _manager_line(key)
	GameState.set_segment(&"r2_listen")
	_manager_heard = false
	_manager_listening = true
	await _wait(manager_listen_seconds)
	_manager_listening = false
	return _manager_heard


## Lane A's actor lunges and finishes the player first (it emits player_caught),
## then the death card and the reload.
func _manager_kills(manager: Node3D, reason: StringName) -> void:
	_pending_death = reason
	if manager != null and manager.has_method("kill_player"):
		manager.kill_player()
		await _wait_until(func() -> bool: return _dying, 3.0, false)
	_die(reason)


func _slash_trung_bed(manager: Node3D) -> void:
	var bed := _bunks.get(TRUNG_BED) as Node3D
	_slash_cuts = 0
	if manager != null and manager.has_method("slash") and bed != null:
		manager.slash(bed)
		await _with_timeout(manager.slash_finished, 10.0, false)
	else:
		var audio := _manager_audio()
		for cut in 6:
			if audio != null:
				audio.play_slash(&"mattress" if cut % 3 != 2 else &"wood")
			_set_bed_slashed(float(cut + 1) / 6.0)
			await _wait(0.45)
	_set_bed_slashed(1.0)


func _on_noise(position: Vector3, radius: float, _source: StringName) -> void:
	if not _manager_listening:
		return
	var manager := get_node_or_null("Manager") as Node3D
	# He listens at head height: breathing on the bunk above Trung's carries.
	var ear := (manager.global_position if manager != null else MANAGER_SPOT) + Vector3(0, 1.6, 0)
	if position.distance_to(ear) <= MANAGER_HEAR_RADIUS:
		_manager_heard = true


func _on_player_caught(entity_id: StringName) -> void:
	if entity_id == &"manager":
		_die(_pending_death if not _pending_death.is_empty() else &"DEATH_HEARD")


# --- Death and end ----------------------------------------------------------------

## A death: card (lane D's death screen when it exists), then reload at the
## stage's checkpoint.
func _die(reason_key: StringName) -> void:
	if _dying:
		return
	_dying = true
	_rules_live = false
	_manager_listening = false
	if GameState.segment in [&"r2_manager", &"r2_listen"]:
		manager_deaths += 1
	EventBus.scare_triggered.emit(&"lost")
	var checkpoint: StringName = DEATH_CHECKPOINTS.get(GameState.segment, &"ch1_prologue")
	var count := int(GameState.get_flag(&"survivors", SURVIVORS_START)) - 1
	# Every chapter death is announced with its reason key (DEATH_*): lane D's
	# death screen (T-156) and the QA bot (T-157) listen to it.
	EventBus.player_failed.emit(reason_key)
	if get_tree().get_first_node_in_group(&"death_screen") != null:
		await _wait(5.0)
	else:
		await _fade_to_black(0.6 if reduce_scares else 0.25)
		_show_card("UI_CH1_DEATH_TITLE", String(reason_key), count)
		await _wait(5.0)
	restart_requested.emit(checkpoint)


func _survivors(count: int) -> void:
	GameState.set_flag(&"survivors", count)
	EventBus.survivor_count_changed.emit(count)


