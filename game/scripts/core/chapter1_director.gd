func _plug_in_charger() -> void:
	if _charging:
		return
	_charging = true
	GameState.set_flag(&"charging", true)
	var charger := _room_anchor("DatLocker/Charger")
	if charger != null:
		charger.visible = false
	var socket := get_node_or_null("ChargerSocket") as StoryTrigger
	if socket != null:
