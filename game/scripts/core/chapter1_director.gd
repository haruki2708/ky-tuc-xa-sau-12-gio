# --- Round 2 at room 407: 5:43 -----------------------------------------------------

func _manager_at_407() -> void:
	_begin(&"r2_manager", "05:43")
	_rules_live = true
	_set_blood(1)
	if manager_deaths >= 1:
		_think("THINK_CH1_HINT_1")
	if manager_deaths >= 2:
		await _wait(4.0)
		_think("THINK_CH1_HINT_2")
	_music(&"set_tension", 1.0)
	await _wait(18.0)
	_music(&"silence_before_door", true)
	_play_knock()
	await _wait(2.0)
	_open_door()
	_set_flicker(true)
	var manager := _spawn_manager()
	await _wait(1.5)
	if _bed == 0:
		await _manager_kills(manager, &"DEATH_NOT_IN_BED")
		return
	await _manager_walk(manager, MANAGER_SPOT, MANAGER_VIA)
	if _bed == 0:
		await _manager_kills(manager, &"DEATH_NOT_IN_BED")
		return
	# The question, then silence: the only moment he listens (breath, a quick
	# turn of the head, getting up).
	var heard := await _manager_ask(manager, "MGR_CH1_ASK_BED_3")
	GameState.set_segment(&"r2_manager")
	if _bed == TRUNG_BED:
		await _manager_kills(manager, &"DEATH_OWN_BED")
		return
	if _bed == 0:
		await _manager_kills(manager, &"DEATH_NOT_IN_BED")
		return
	if heard:
		await _manager_kills(manager, &"DEATH_HEARD")
		return
	await _manager_line("MGR_CH1_LAUGH")
	await _slash_trung_bed(manager)
	await _manager_walk(manager, DOOR_SPOT, MANAGER_OUT_VIA)
	if manager != null:
		manager.queue_free()
	_close_door()
	_set_flicker(false)
	_music(&"silence_before_door", false)
	_music(&"set_tension", 0.2)
	await _wait(3.0)
	_set_clock("05:46")
	_think("THINK_CH1_SURVIVED")
	await _wait(4.0)
	_think("THINK_CH1_WHY")
	await _wait(5.0)
	await _choice(&"tell", 1)


