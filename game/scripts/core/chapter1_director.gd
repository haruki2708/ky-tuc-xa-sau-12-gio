## Waits up to `seconds`, or less once every active mission of the round is
## done (D-040: no idle time when the player has finished everything).
func _gap(seconds: float) -> void:
	await _wait_until(_round_done, seconds)


func _round_done() -> bool:
	if _missions.has(&"ready"):
		_missions[&"ready"] = _ready_for_manager()
	if _missions.has(&"form"):
		_missions[&"form"] = _form_pieces.size() >= 3
	if _missions.has(&"network"):
		_missions[&"network"] = _network_up
	if _missions.has(&"locker"):
		_missions[&"locker"] = GameState.get_flag(&"has_charger", false) == true
	for done: bool in _missions.values():
		if not done:
			return false
	return not _missions.is_empty()


## Lamp off, phone down, flashlight off, lying still on a dead roommate's bed.
func _ready_for_manager() -> bool:
	return _bed in [1, 2, 4] and not _traces_visible()


func _apply_insane() -> void:
	if _player != null and "max_breath_seconds" in _player:
		_player.set("max_breath_seconds", MAX_BREATH_SECONDS)


## Lane A's interactables (T-161) on lane B's anchors (T-162). Missing pieces
## are skipped: the chapter still runs, that mission just cannot be done.
func _place_mission_props() -> void:
	var room := _room()
	if room == null:
		return
	# Search spots for the torn inspection form (N5).
	var search_scene := "res://scenes/interaction/search_spot.tscn"
	var spots := {"VietLocker": [&"viet_locker", "PROMPT_CH1_SEARCH_LOCKER", &"ch1_form_piece_1"],
		"PhucMattress": [&"phuc_mattress", "PROMPT_CH1_LIFT_MATTRESS", &"ch1_form_piece_2"],
		"TrashBin": [&"trash_bin", "PROMPT_CH1_SEARCH_TRASH", &"ch1_form_piece_3"]}
	if ResourceLoader.exists(search_scene):
		for anchor_name: String in spots:
			var anchor := _room_anchor(anchor_name)
			if anchor == null:
				continue
			var spot := load(search_scene).instantiate() as Node3D
			spot.name = "Search" + anchor_name
			spot.set("spot_id", spots[anchor_name][0])
			spot.set("prompt_key", spots[anchor_name][1])
			spot.set("document_id", spots[anchor_name][2])
			anchor.add_child(spot)
			# Lane B's anchors sit at the model's origin (locker foot, middle of
			# the upper bunk); the player's ray must reach the front face.
			spot.global_position = anchor.global_position + SEARCH_OFFSETS.get(anchor_name, Vector3.ZERO)
			if spot.has_signal("searched"):
				spot.searched.connect(_on_searched.bind(anchor_name))
	# Shared wall with 406 (N3).
	var wall_scene := "res://scenes/interaction/wall_knock.tscn"
	var wall := _room_anchor("WallKnock406")
	if wall != null and ResourceLoader.exists(wall_scene):
		var knock := load(wall_scene).instantiate() as Node3D
		knock.name = "WallKnock406"
		knock.set("wall_id", &"wall_406")
		wall.add_child(knock)
	# Power strip (N2): lane A's three switch areas over lane B's model.
	var strip_anchor := _room_anchor("PowerStrip")
	if strip_anchor != null:
		# Lane B's strip sits half under bunk A: out from under it so every
		# switch can be aimed at standing up.
		strip_anchor.global_position += STRIP_NUDGE
	if strip_anchor != null and ResourceLoader.exists("res://scenes/interaction/power_strip.tscn"):
		var strip := load("res://scenes/interaction/power_strip.tscn").instantiate() as Node3D
		strip.name = "PowerStripInteract"
		strip_anchor.add_child(strip)
		for n in range(1, 4):
			var area := strip.get_node_or_null("Switch%d" % n) as Node3D
			var model := strip_anchor.get_node_or_null("Switch%d" % n) as Node3D
			if area != null and model != null and model != area:
				area.global_transform = model.global_transform
		for placeholder_path in ["Placeholder", "Switch1/Placeholder", "Switch2/Placeholder", "Switch3/Placeholder"]:
			var placeholder := strip.get_node_or_null(placeholder_path) as Node3D
			if placeholder != null:
				placeholder.visible = false
		strip.switch_toggled.connect(func(index: int, on: bool) -> void:
			if strip_anchor.has_method("set_switch"):
				strip_anchor.set_switch(index + 1, on)
			_on_strip_switch(index + 1, on))
	# Network cables (N2): two loose ends and the wall socket.
	for entry: Array in [["LanBlueEnd", &"blue"], ["LanGrayEnd", &"gray"]]:
		var end := _room_anchor(entry[0])
		if end != null and ResourceLoader.exists("res://scenes/interaction/lan_cable.tscn"):
			var cable := load("res://scenes/interaction/lan_cable.tscn").instantiate() as Node3D
			cable.name = "Cable_" + String(entry[1])
			cable.set("cable_id", entry[1])
			end.add_child(cable)
	var port := _room_anchor("LanWallPort")
	if port != null and ResourceLoader.exists("res://scenes/interaction/lan_socket.tscn"):
		var socket := load("res://scenes/interaction/lan_socket.tscn").instantiate() as Node3D
		socket.name = "LanSocket"
		port.add_child(socket)
		socket.plugged.connect(func(cable_id: StringName) -> void:
			GameState.set_flag(&"lan_plugged", String(cable_id))
			if room.has_method("set_plugged"):
				room.set_plugged(cable_id, true)
			_on_cable_plugged(cable_id))
		socket.unplugged.connect(func(cable_id: StringName) -> void:
			GameState.set_flag(&"lan_plugged", "")
			if room.has_method("set_plugged"):
				room.set_plugged(cable_id, false)
			_on_cable_unplugged(cable_id))
	# Desk lamp switch (N6).
	var lamp_anchor := _room_anchor("DeskLampSwitch")
	if lamp_anchor != null and ResourceLoader.exists("res://scenes/interaction/desk_lamp_switch.tscn"):
		var lamp_switch := load("res://scenes/interaction/desk_lamp_switch.tscn").instantiate() as Node3D
		lamp_switch.name = "DeskLampSwitch"
		var lamp := room.find_child("Room407DeskLamp", true, false)
		if lamp != null:
			lamp_switch.set("light", lamp)
		lamp_anchor.add_child(lamp_switch)
		GameState.set_flag(&"desk_lamp_on", lamp != null and (lamp as Node3D).visible)
	# Door latch (N4): lane A's latch on the door leaf, as in the demo.
	var latch_scene := "res://scenes/interaction/door_latch.tscn"
	var door := _door()
	if door != null and ResourceLoader.exists(latch_scene) and door.get_node_or_null("Pivot") != null:
