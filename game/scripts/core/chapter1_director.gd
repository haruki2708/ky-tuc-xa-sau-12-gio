# --- Group call ---------------------------------------------------------------------

func _phone_screen() -> Node:
	return get_parent().get_node_or_null("PhoneScreen") if get_parent() else null


## The call history (T-155 snapshot) and battery ride in GameState flags, so
## they are saved with the checkpoint.
func _store_phone() -> void:
	var screen := _phone_screen()
	if screen != null and screen.has_method("snapshot"):
		GameState.set_flag(&"phone_snapshot", JSON.stringify(screen.snapshot()))
	var phone := _phone_item()
	if phone != null and "battery" in phone:
		GameState.set_flag(&"phone_battery", float(phone.battery))
	GameState.set_flag(&"in_call", _call_answered)


func _restore_phone() -> void:
	var screen := _phone_screen()
	var saved: Variant = GameState.get_flag(&"phone_snapshot", "")
	if screen != null and screen.has_method("restore") and saved is String and not saved.is_empty():
		var data: Variant = JSON.parse_string(saved)
		if data is Dictionary:
			screen.restore(data)
			# Keep the phone in Trung's hand in step with the restored screen.
			var phone := _phone_item()
			if phone != null and phone.has_method("set_raised"):
				phone.set_raised(data.get("raised", false) == true)
	if GameState.has_flag(&"phone_battery"):
		_set_battery(float(GameState.get_flag(&"phone_battery", 100.0)))
	_call_answered = GameState.get_flag(&"in_call", false) == true
	_set_in_call(_call_answered)


func _incoming_call() -> void:
	_call_answered = false
	for ring in 4:
		EventBus.phone_call_incoming.emit(&"stranger_call")
		await _wait_until(func() -> bool: return _call_answered, 20.0)
		if _call_answered:
			break
	# Without a phone screen (T-155) there is no way to answer: carry on.
	_call_answered = true
	_set_in_call(true)


## One spoken line of the group call (MessageData chat_ch1_<id>). Lane E plays
## its voice and lane D shows it; the wait estimates the spoken length.
func _line(id: String) -> void:
	var message_id := StringName("chat_%s_%s" % [_chapter_tag(), id])
	var data := MessageData.load_by_id(message_id)
	if data == null:
		push_warning("Chapter1Director: missing message " + message_id)
		return
	if not _network_up:
		# Spoken while the call is down: nobody hears it (missed).
		await _wait(_spoken_seconds(data.text_key) * 0.5)
		return
	EventBus.phone_message_received.emit(message_id)
	var seconds := _voice_seconds(data.text_key, "CHAT_%s_" % _chapter_tag().to_upper())
	# Lane D's phone screen (T-155) subtitles every spoken line itself.
	if _phone_screen() == null:
		_say(data.text_key, seconds)
	await _wait(seconds + 0.4)


## Offers Trung's replies; returns the picked index (0-based). Time out or no
## phone screen picks the first. The reply then appears in the call.
func _choice(id: StringName, count: int, seconds: float = -1.0, timeout_index: int = 0) -> int:
	var keys := PackedStringArray()
	for n in range(1, count + 1):
		keys.append("CHOICE_%s_%s_%d" % [_chapter_tag().to_upper(), String(id).to_upper(), n])
	_choice_id = id
	_choice_index = -2
	EventBus.chat_choice_requested.emit(id, keys)
	await _wait_until(func() -> bool: return _choice_index != -2, choice_seconds if seconds < 0.0 else seconds)
	var picked := _choice_index if _choice_index >= 0 else timeout_index
	_choice_id = &""
	if picked < 0:
		GameState.set_flag(StringName("%s_choice_%s" % [_chapter_tag(), id]), -1)
		await _wait(0.5)
		return -1
	picked = clampi(picked, 0, count - 1)
	EventBus.phone_message_received.emit(StringName("choice_%s_%s_%d" % [_chapter_tag(), id, picked + 1]))
	GameState.set_flag(StringName("%s_choice_%s" % [_chapter_tag(), id]), picked)
	await _wait(1.2)
	return picked


func _on_choice_made(choice_id: StringName, index: int) -> void:
	if choice_id == _choice_id:
		_choice_index = index


func _member_dies(member: StringName, where: Vector3) -> void:
	EventBus.chat_member_changed.emit(member, &"dead")
	_screams(where, 1, 0.0)


