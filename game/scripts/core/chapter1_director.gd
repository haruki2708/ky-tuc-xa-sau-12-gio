## The manager somewhere else in the building: only his blade is heard (T-158).
func _manager_far(where: Vector3) -> void:
	var audio := _manager_audio()
	if audio != null and audio.has_method("place_at"):
		audio.place_at(where)
		if audio.has_method("play_drag"):
			audio.play_drag(true)


func _manager_line(key: String, manager: Node = null) -> void:
	var seconds := _spoken_seconds(key)
	var audio := _manager_audio()
	if manager != null and manager.has_method("ask"):
		manager.ask(key)
	elif audio != null and audio.has_method("say"):
		# The rig plays the voice (T-159) or shows the subtitle itself.
		seconds = maxf(float(audio.say(key)), 0.5)
	else:
		_say(key, seconds)
	await _wait(seconds + 0.5)


func _manager_audio() -> Node3D:
	return get_tree().get_first_node_in_group(&"manager_audio") as Node3D


func _spawn_manager() -> Node3D:
	var audio := _manager_audio()
	if audio != null:
		audio.place_at(CORRIDOR_SPOT)
	if not ResourceLoader.exists(MANAGER_SCENE):
		return null
	var manager := load(MANAGER_SCENE).instantiate() as Node3D
	if manager == null:
		return null
	manager.name = "Manager"
	manager.set("player", _player)
	manager.set("listen_seconds", MANAGER_LISTEN_SECONDS)
	# D-069 (1): no listening for movement or breath; only getting up gives Trung away.
	manager.set("hear_movement_while_present", false)
	manager.set("speed", APPROACH_SPEED)
	manager.set("look_target", _bunks.get(TRUNG_BED))
	if ResourceLoader.exists(MANAGER_BODY):
		manager.set("body_scene", load(MANAGER_BODY))
	add_child(manager)
	manager.global_position = CORRIDOR_SPOT
	if manager.has_signal("slashed"):
		manager.slashed.connect(func(_target: Node3D) -> void: _slash_progress())
	return manager


var _slash_cuts: int = 0


func _slash_progress() -> void:
	_slash_cuts += 1
	_set_bed_slashed(minf(float(_slash_cuts) / 6.0, 1.0))


## The actor moves in real time; its waits are not scaled (tests speed up only
## the director's own beats). With `stop_on_stand` the walk is cut short when
## Trung gets out of bed (D-069 1: getting up is the one thing that gives him away).
func _manager_walk(manager: Node3D, to: Vector3, via: PackedVector3Array = PackedVector3Array(), stop_on_stand: bool = false) -> void:
	if manager == null or not manager.has_method("walk_to"):
		var audio := _manager_audio()
		if audio != null:
			audio.place_at(to)
		await _wait(2.5)
		return
	var arrived := [false]
	manager.arrived.connect(func() -> void: arrived[0] = true, CONNECT_ONE_SHOT)
	manager.walk_to(to, via)
	await _wait_until(func() -> bool: return arrived[0] or (stop_on_stand and _bed == 0), 15.0, false)


## Asks one line and waits out the short silence after it. D-069 (1): he no
## longer listens, so the result is only "Trung got up" (the caller checks `_bed`).
func _manager_ask(manager: Node3D, key: String) -> void:
	if manager != null and manager.has_method("ask") and manager.has_signal("answered"):
		var answered := [false]
		manager.answered.connect(func(_heard: bool) -> void: answered[0] = true, CONNECT_ONE_SHOT)
		manager.ask(key)
		# He is silent once the question is out (T-152): mark that moment.
		await _wait_until(func() -> bool: return answered[0] or _bed == 0, _voice_seconds(key, "MGR_CH1_"), false)
		GameState.set_segment(&"r2_listen")
		await _wait_until(func() -> bool: return answered[0] or _bed == 0, 30.0, false)
		return
	# Core stand-in: the rig speaks, then a short silence.
	await _manager_line(key)
	GameState.set_segment(&"r2_listen")
	await _wait(manager_listen_seconds)


## Lane A's actor lunges and finishes the player first (it emits player_caught),
## then the death card and the reload.
func _manager_kills(manager: Node3D, reason: StringName) -> void:
	_pending_death = reason
	# The jumpscare scene starts with the lunge (D-042), not after it.
	_death_scene_started = true
	EventBus.player_death_started.emit(&"manager_kill")
	if manager != null and manager.has_method("kill_player"):
		manager.kill_player()
		await _wait_until(func() -> bool: return _dying, 3.0, false)
	_die(reason)


func _slash_trung_bed(manager: Node3D) -> void:
	var bed := _bunks.get(TRUNG_BED) as Node3D
	_slash_cuts = 0
	if manager != null and manager.has_method("slash") and bed != null:
		var finished := [false]
		manager.slash_finished.connect(func() -> void: finished[0] = true, CONNECT_ONE_SHOT)
		manager.slash(bed)
		await _wait_until(func() -> bool: return finished[0] or _bed == 0, 10.0, false)
	else:
		var audio := _manager_audio()
		for cut in 6:
			if audio != null:
				audio.play_slash(&"mattress" if cut % 3 != 2 else &"wood")
			_set_bed_slashed(float(cut + 1) / 6.0)
			await _wait(0.45)
	_set_bed_slashed(1.0)


func _on_player_caught(entity_id: StringName) -> void:
	if entity_id == &"manager":
		_die(_pending_death if not _pending_death.is_empty() else &"DEATH_HEARD")


# --- Death and end ----------------------------------------------------------------

## A death: card (lane D's death screen when it exists), then reload at the
## stage's checkpoint.
func _die(reason_key: StringName) -> void:
	if _dying:
		return
	_dying = true
	_rules_live = false
	if GameState.segment in [&"r2_manager", &"r2_listen"]:
		manager_deaths += 1
	EventBus.scare_triggered.emit(&"lost")
	var kind: StringName = _death_kinds().get(reason_key, &"fall_back")
	if not _death_scene_started:
		_death_scene_started = true
		EventBus.player_death_started.emit(kind)
	if kind != &"none":
		await _death_scene()
	var checkpoint: StringName = _death_checkpoints().get(GameState.segment, _checkpoints().values()[0])
	var count := int(GameState.get_flag(&"survivors", SURVIVORS_START)) - 1
	# Every chapter death is announced with its reason key (DEATH_*): lane D's
	# death screen (T-156) and the QA bot (T-157) listen to it.
	EventBus.player_failed.emit(reason_key)
	if get_tree().get_first_node_in_group(&"death_screen") != null:
		await _wait(5.0)
	else:
		await _fade_to_black(0.6 if reduce_scares else 0.25)
		_show_card("UI_CH1_DEATH_TITLE", String(reason_key), count)
		await _wait(5.0)
	restart_requested.emit(checkpoint)


func _survivors(count: int) -> void:
	GameState.set_flag(&"survivors", count)
	EventBus.survivor_count_changed.emit(count)


