## Puts the player on a bed (start of the chapter, resume). Uses lane A's bunk
## (T-151) when it exists, otherwise the core stub.
func lie_on(bed: int) -> void:
	var spot: Node = _bunks.get(bed)
	if spot != null and _player != null and _player.has_method("lie_on") and not spot is StoryTrigger:
		_player.lie_on(spot)
		return
	var anchor := _anchor(BED_ANCHORS[bed])
	if anchor == null or _player == null:
		_bed = bed
		return
	_player.global_position = anchor.global_position + Vector3(0, 0.05, 0)
	_player.set_physics_process(false)
	_stub_lying = true
	_set_bed(bed)
	EventBus.player_hidden.emit(true, &"bunk")


func get_up() -> void:
	if _player == null:
		return
	if not _stub_lying:
		# Lane A's bunk (T-151): the player leaves through its exit marker.
		if _player.has_method("is_hidden") and _player.is_hidden() and _player.has_method("leave_hide_spot"):
			_player.leave_hide_spot()
		return
	_player.global_position = BED_EXIT.get(_bed, Vector3(32.0, 0.05, -2.2))
	_player.set_physics_process(true)
	_stub_lying = false
	_set_bed(0)
	EventBus.player_hidden.emit(false, &"bunk")


func _set_bed(bed: int) -> void:
	_bed = bed
	GameState.set_flag(&"player_bed", bed)


func _on_flag_changed(flag: StringName, value: Variant) -> void:
	if flag == &"player_bed" and value is int:
		_bed = value


func _unhandled_input(event: InputEvent) -> void:
	if _stub_lying and event.is_action_pressed("interact"):
		get_viewport().set_input_as_handled()
		get_up()


func _place_bunks() -> void:
	if _floor == null:
		return
	var scene: PackedScene = load(BUNK_SCENE) if ResourceLoader.exists(BUNK_SCENE) else null
	for bed: int in BED_ANCHORS:
		# Lane B's room anchors (T-153) carry View/Exit markers; the floor's
		# Bed_* markers are the fallback.
		var room_anchor := _room_anchor("Bunks/Bunk%d" % bed)
		var anchor := room_anchor if room_anchor != null else _anchor(BED_ANCHORS[bed])
		if anchor == null:
			continue
		var spot: Node3D
		if scene != null:
			spot = scene.instantiate()
			spot.set("bed_number", bed)
			if room_anchor != null:
				spot.name = "Bunk%d" % bed
				room_anchor.add_child(spot)
				spot.set("view", NodePath("../View"))
				spot.set("exit", NodePath("../Exit"))
				_bunks[bed] = spot
				continue
		else:
			var stub := StoryTrigger.new()
			stub.prompt_key = "PROMPT_CH1_LIE"
			stub.size = Vector3(0.9, 0.4, 1.9)
			stub.triggered.connect(lie_on.bind(bed))
			spot = stub
		spot.name = "Bunk%d" % bed
		add_child(spot)
		spot.global_transform = anchor.global_transform
		_bunks[bed] = spot


