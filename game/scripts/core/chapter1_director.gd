class_name Chapter1Director
extends Node
## Chapter 1 "Tổng tắc" (docs/design/STORY.md v2 §5; lines in
## docs/design/CH1_SCRIPT.md, generated by docs/design/ch1/build_ch1_script.py):
##   prologue 4:00 get out of bed within a minute → General Rules →
##   round 1 4:05 locked in, group call, Đạt's locker, a voice at the door →
##   round 2 5:00 the manager checks the rooms → 407: lie on a dead roommate's
##   bed and hold your breath → 6:00 end.
## Lane pieces are optional. Missing bunks (T-151), manager (T-152), room API
## (T-153), phone screen (T-155), death screen (T-156) or voices (T-158/159)
## fall back to stubs, subtitles and timers, so the chapter always runs.
## Owner: integrator.

signal chapter_done
## A death: Main reloads the scene and resumes from this checkpoint.
signal restart_requested(checkpoint_id: StringName)

const RULE_SET_PATH := "res://data/rules/ch1.tres"
const STAGES: Array[StringName] = [&"prologue", &"r1", &"r2", &"r2_manager", &"end"]
## Checkpoint id of each stage (ids start with "ch1_": App routes "Continue").
const CHECKPOINTS := {
	&"prologue": &"ch1_prologue", &"r1": &"ch1_r1", &"r2": &"ch1_r2", &"r2_manager": &"ch1_r2_manager",
}
## Deaths reload the checkpoint of the stage they happen in. r2_listen is the
## silence after the manager's question, inside the r2_manager stage.
const DEATH_CHECKPOINTS := {
	&"prologue": &"ch1_prologue", &"r1": &"ch1_r1", &"r2": &"ch1_r2", &"r2_manager": &"ch1_r2_manager",
	&"r2_listen": &"ch1_r2_manager",
}
## The manager walks in through the door, around the open leaf (T-152 needs
## clear straight lines between waypoints).
const MANAGER_VIA: PackedVector3Array = [Vector3(32.0, 0.05, -0.8)]
const MANAGER_OUT_VIA: PackedVector3Array = [Vector3(32.0, 0.05, -0.8)]
const MANAGER_BODY := "res://scenes/levels/ch1_models/manager_body.tscn"
const ROOM_407_X := Vector2(30.0, 34.0)
## Bed number → floor 4 anchor (docs/tasks/T-150: 1 Phúc, 2 Việt, 3 Trung, 4 Đạt).
const BED_ANCHORS := {1: "Bed_Phuc", 2: "Bed_Viet", 3: "Bed_Trung", 4: "Bed_Dat"}
const TRUNG_BED := 3
## Where the player stands up from a bed (room floor, between the bunks).
const BED_EXIT := {1: Vector3(31.4, 0.05, -2.2), 2: Vector3(31.4, 0.05, -2.2),
	3: Vector3(32.6, 0.05, -2.2), 4: Vector3(32.6, 0.05, -2.2)}
## Spot in front of Trung's bunk where the manager stands and listens.
const MANAGER_SPOT := Vector3(33.0, 0.05, -1.9)
## Without lane A's manager: he hears anything within this distance of his head
## while he waits for an answer (same rule as T-152).
const MANAGER_HEAR_RADIUS := 4.0
## Silence he waits for after the question; shorter than the 8 s breath hold.
const MANAGER_LISTEN_SECONDS := 5.0
const DOOR_SPOT := Vector3(32.0, 0.05, 0.6)
const BUNK_SCENE := "res://scenes/interaction/bunk_spot.tscn"
const PUZZLE_STATION_SCENE := "res://scenes/interaction/puzzle_station.tscn"
const MANAGER_SCENE := "res://scenes/entity/manager.tscn"
const SURVIVORS_START := 3712
const SURVIVORS_R1 := 352
const SURVIVORS_R2 := 28
## Named group-call members, in the order they join.
const MEMBERS: Array[StringName] = [&"hung", &"dang", &"bao", &"son", &"kiet", &"tung", &"vinh"]

## Checkpoint to resume after a reload (kept across the scene change).
static var resume_checkpoint: StringName = &""
## Deaths in the manager scene this session: the second shows HINT_1, the third HINT_2.
static var manager_deaths: int = 0

## Multiplies every wait; tests use a small value.
@export var time_scale: float = 1.0
@export var auto_start: bool = true
@export var player_path: NodePath = ^"../Player"
@export var floor_path: NodePath = ^"../Floor4"
@export var speaker_path: NodePath = ^""
## Seconds per speaker line while there is no voice (subtitles only).
@export var line_seconds: float = 4.5
@export var get_up_seconds: float = 60.0
@export var choice_seconds: float = 12.0
@export var manager_listen_seconds: float = 5.0
## Stop after this stage (tests run one stretch). Empty = to the end.
@export var stop_after: StringName = &""

