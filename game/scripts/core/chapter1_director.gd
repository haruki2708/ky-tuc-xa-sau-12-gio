var _overlay_count: Label


func _ready() -> void:
	_player = get_node_or_null(player_path) as Node3D
	_floor = get_node_or_null(floor_path) as Node3D
	EventBus.phone_call_answered.connect(func(_id: StringName) -> void: _call_answered = true)
	EventBus.chat_choice_made.connect(_on_choice_made)
	EventBus.noise_emitted.connect(_on_noise)
	EventBus.flag_changed.connect(_on_flag_changed)
	EventBus.puzzle_solved.connect(_on_puzzle_solved)
	EventBus.player_caught.connect(_on_player_caught)
	EventBus.settings_changed.connect(_on_settings_changed)
	EventBus.checkpoint_saving.connect(func(_id: StringName) -> void: _store_phone())
	_read_reduce_scares()
	_build_overlay()
	_place_bunks()
	_place_room_props()
	if auto_start:
		start.call_deferred()


func _physics_process(_delta: float) -> void:
	if _rules_live and not _dying and _player != null and not _player_in_room():
		_die(&"DEATH_LEFT_ROOM")


## Starts the chapter, or resumes from resume_checkpoint after a reload.
func start() -> void:
	var errors := RuleSystem.load_rule_set(load(RULE_SET_PATH))
	if not errors.is_empty():
		push_warning("Chapter1Director: rules invalid: %s" % ", ".join(errors))
		return
	var from := &"prologue"
	if not resume_checkpoint.is_empty():
		var restored := Checkpoint.restore()
		resume_checkpoint = &""
		for stage: StringName in CHECKPOINTS:
			if CHECKPOINTS[stage] == restored:
				from = stage
		_restore_phone()
		# Resume standing in the middle of 407 (the prologue lies down itself).
		_set_bed(0)
		if from != &"prologue":
			_place_player(Vector3(32.0, 0.05, -1.6))
			_set_corpses_watching.call_deferred(true)
	else:
		manager_deaths = 0
		GameState.reset()
	GameState.chapter = 1
	EventBus.chapter_started.emit(1)
	await run_from(from)


## Runs the chapter from a stage in STAGES (tests start mid-chapter too).
func run_from(stage: StringName) -> void:
	var index := STAGES.find(stage)
	if index < 0:
		push_warning("Chapter1Director: unknown stage '%s'" % stage)
		return
	for i in range(index, STAGES.size()):
		if _dying or not is_inside_tree():
			return
		match STAGES[i]:
			&"prologue": await _prologue()
			&"r1": await _round_1()
			&"r2": await _round_2()
			&"r2_manager": await _manager_at_407()
			&"end": await _ending()
		if STAGES[i] == stop_after:
			break
	if not _dying and is_inside_tree():
		finished = true
		chapter_done.emit()


func _begin(stage: StringName, clock: String) -> void:
	GameState.set_segment(stage)
	_set_clock(clock)
	if CHECKPOINTS.has(stage):
		Checkpoint.save(CHECKPOINTS[stage])


# --- Prologue: 4:00 -------------------------------------------------------------

func _prologue() -> void:
	_begin(&"prologue", "04:00")
	GameState.set_flag(&"survivors", SURVIVORS_START)
	_rules_live = false
	_set_blood(0)
	lie_on(TRUNG_BED)
	await _wait(2.0)
	await _announce(["SPK_CH1_WARN"])
	await _room_line("ROOM_CH1_PHUC_GRUMBLE", 2.5)
	await _room_line("ROOM_CH1_DAT_GRUMBLE", 2.5)
	await _room_line("ROOM_CH1_VIET_GRUMBLE", 2.0)
	_think("THINK_CH1_GET_UP")
	var minute_started := Time.get_ticks_msec()
	await _wait_until(func() -> bool: return _bed == 0, get_up_seconds)
	if _bed != 0:
		_die(&"DEATH_STAYED_IN_BED")
		return
	# The minute runs out wherever the player is: everyone still in bed dies.
	var used := float(Time.get_ticks_msec() - minute_started) / 1000.0 / maxf(time_scale, 0.0001)
	await _wait(maxf(get_up_seconds - used, 0.0))
	_screams(_room_center(), 6, 4.0)
	_set_blood(1)
	GameState.set_flag(&"roommates_dead", true)
	_set_corpses_watching(true)
	await _wait_until(_player_in_room, 120.0)
	await _wait(1.0)
	_think("THINK_CH1_RETURN")
	await _wait(2.5)
	_think("THINK_CH1_BLOOD")
	await _wait(3.0)
	_think("THINK_CH1_NO_SIGNAL")
	# The General Rules come as the player reaches for the door (or after a while).
	await _wait_until(func() -> bool: return _near_door() or not _player_in_room(), 40.0)
	await _announce(["SPK_CH1_GENERAL_INTRO", "RULE_CH1_GENERAL_1", "RULE_CH1_GENERAL_2",
		"RULE_CH1_GENERAL_3", "RULE_CH1_GENERAL_4", "RULE_CH1_GENERAL_5"])
	for n in range(1, 6):
		RuleSystem.mark_read(StringName("ch1_general_%d" % n))
	# Out in the corridor when the rule lands: back inside first, no trap.
	if not _player_in_room():
		_place_player(Vector3(32.0, 0.05, -1.0))
	_think("THINK_CH1_HAND_OFF")
	await _wait(2.0)


