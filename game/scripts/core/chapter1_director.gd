func _announce(keys: Array) -> void:
	var speaker := get_node_or_null(speaker_path)
	if speaker != null and speaker.has_method("play_announcement"):
		var lines: Array = []
		for key: String in keys:
			lines.append({"text_key": key, "garbled": false})
		speaker.play_announcement(lines, line_seconds * time_scale)
		await speaker.announcement_finished
	else:
		for key: String in keys:
			_say(key, line_seconds)
			await _wait(line_seconds)


## Where a roommate's voice comes from (beds of T-150, Việt at the door).
const ROOM_VOICES := {
	"ROOM_CH1_PHUC_GRUMBLE": Vector3(30.65, 1.4, -3.0),
	"ROOM_CH1_DAT_GRUMBLE": Vector3(33.35, 1.4, -3.0),
	"ROOM_CH1_VIET_GRUMBLE": Vector3(30.65, 0.7, -3.0),
	"ROOM_CH1_KNOCK_VIET": Vector3(32.0, 1.5, 0.5),
	"ROOM_CH1_KNOCK_VIET_2": Vector3(32.0, 1.5, 0.5),
}


func _room_line(key: String, seconds: float) -> void:
	var clip := Ch1AudioBank.voice(key, "ROOM_CH1_")
	if clip != null and is_inside_tree():
		var voice := AudioStreamPlayer3D.new()
		voice.stream = clip
		voice.bus = &"Voice"
		voice.unit_size = 3.0
		add_child(voice)
		voice.global_position = ROOM_VOICES.get(key, _room_center())
		voice.finished.connect(voice.queue_free)
		voice.play()
		seconds = maxf(seconds, clip.get_length() + 0.3)
	_say(key, seconds)
	await _wait(seconds)


## Length of a voiced line (T-159), or the text-length estimate without one.
func _voice_seconds(key: String, prefix: String) -> float:
	var clip := Ch1AudioBank.voice(key, prefix)
	return clip.get_length() + 0.2 if clip != null else _spoken_seconds(key)


func _think(key: String) -> void:
	_say(key, _spoken_seconds(key) + 1.0)


func _say(key: String, seconds: float) -> void:
	EventBus.subtitle_requested.emit(key, maxf(seconds * time_scale, 0.05))


## Rough spoken length of a line until lane E's voice bank reports real ones.
func _spoken_seconds(key: String) -> float:
	return 1.0 + float(tr(key).length()) / 14.0


func _player_in_room() -> bool:
	if _player == null:
		return true
	var p := _player.global_position
	return p.x > ROOM_407_X.x and p.x < ROOM_407_X.y and p.z < 0.05 and p.y > -1.0 and p.y < 3.0


func _near_door() -> bool:
	return _player != null and _player.global_position.distance_to(Vector3(32.0, _player.global_position.y, -0.3)) < 1.0


func _room_center() -> Vector3:
