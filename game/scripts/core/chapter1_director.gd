func _ready() -> void:
	_player = get_node_or_null(player_path) as Node3D
	_floor = get_node_or_null(floor_path) as Node3D
	EventBus.phone_call_answered.connect(func(_id: StringName) -> void: _call_answered = true)
	EventBus.chat_choice_made.connect(_on_choice_made)
	EventBus.flag_changed.connect(_on_flag_changed)
	EventBus.puzzle_solved.connect(_on_puzzle_solved)
	EventBus.player_caught.connect(_on_player_caught)
	EventBus.settings_changed.connect(_on_settings_changed)
	EventBus.checkpoint_saving.connect(func(_id: StringName) -> void: _store_phone())
	EventBus.wall_tapped.connect(_on_wall_tapped)
	EventBus.document_opened.connect(_on_document_opened)
	EventBus.document_closed.connect(_on_document_closed)
	if _player != null and _player.has_signal("death_animation_finished"):
		_player.death_animation_finished.connect(func() -> void: _death_animation_done = true)
	_read_reduce_scares()
	_build_overlay()
	_place_bunks()
	_place_room_props()
	_place_mission_props()
	_build_cctv()
	_apply_insane()
	if auto_start:
		start.call_deferred()


func _physics_process(_delta: float) -> void:
	if _rules_live and not _dying and _player != null and not _player_in_room():
		_die(&"DEATH_LEFT_ROOM")


## Starts the chapter, or resumes from resume_checkpoint after a reload.
func start() -> void:
	var errors := RuleSystem.load_rule_set(load(_rule_set_path()))
	if not errors.is_empty():
		push_warning("Chapter1Director: rules invalid: %s" % ", ".join(errors))
		return
	var from: StringName = _stages()[0]
	if not resume_checkpoint.is_empty():
		var restored := Checkpoint.restore()
		resume_checkpoint = &""
		var checkpoints := _checkpoints()
		for stage: StringName in checkpoints:
			if checkpoints[stage] == restored:
				from = stage
		_restore_phone()
		# Resume standing in the middle of 407 (the prologue lies down itself).
		_set_bed(0)
		if from != &"prologue":
			_place_player(Vector3(32.0, 0.05, -1.6))
			_set_corpses_watching.call_deferred(true)
	else:
		manager_deaths = 0
		GameState.reset()
	GameState.chapter = _chapter()
	EventBus.chapter_started.emit(_chapter())
	await run_from(from)


## Runs the chapter from a stage in STAGES (tests start mid-chapter too).
func run_from(stage: StringName) -> void:
	var stages := _stages()
	var index := stages.find(stage)
	if index < 0:
		push_warning("Chapter director: unknown stage '%s'" % stage)
		return
	for i in range(index, stages.size()):
		if _dying or not is_inside_tree():
			return
		await _run_stage(stages[i])
		if stages[i] == stop_after:
			break
	if not _dying and is_inside_tree():
		finished = true
		chapter_done.emit()


func _begin(stage: StringName, clock: String) -> void:
	GameState.set_segment(stage)
	_set_clock(clock)
	if _checkpoints().has(stage):
		Checkpoint.save(_checkpoints()[stage])


# --- What a chapter defines (chapter 2 overrides these, T-170) -------------------

func _chapter() -> int:
	return 1


func _rule_set_path() -> String:
	return RULE_SET_PATH


func _stages() -> Array[StringName]:
	return STAGES


func _run_stage(stage: StringName) -> void:
	match stage:
		&"prologue": await _prologue()
		&"r1": await _round_1()
		&"r2": await _round_2()
		&"r2_manager": await _manager_at_407()
		&"end": await _ending()


func _checkpoints() -> Dictionary:
	return CHECKPOINTS


func _death_checkpoints() -> Dictionary:
	return DEATH_CHECKPOINTS


func _death_kinds() -> Dictionary:
	return DEATH_KINDS


## Message ids and string keys of this chapter's call ("chat_ch1_", "CHAT_CH1_"…).
func _chapter_tag() -> String:
	return "ch%d" % _chapter()


# --- Prologue: 4:00 -------------------------------------------------------------

func _prologue() -> void:
	_begin(&"prologue", "04:00")
	GameState.set_flag(&"survivors", SURVIVORS_START)
	_rules_live = false
	_set_blood(0)
	lie_on(TRUNG_BED)
	await _wait(2.0)
	await _announce(["SPK_CH1_WARN"])
	await _room_line("ROOM_CH1_PHUC_GRUMBLE", 2.5)
	await _room_line("ROOM_CH1_DAT_GRUMBLE", 2.5)
	await _room_line("ROOM_CH1_VIET_GRUMBLE", 2.0)
	var minute_started := Time.get_ticks_msec()
	await _wait_until(func() -> bool: return _bed == 0, get_up_seconds)
	if _bed != 0:
		_die(&"DEATH_STAYED_IN_BED")
		return
	# The minute runs out wherever the player is: everyone still in bed dies.
	var used := float(Time.get_ticks_msec() - minute_started) / 1000.0 / maxf(time_scale, 0.0001)
	await _wait(maxf(get_up_seconds - used, 0.0))
	_screams(_room_center(), 6, 4.0)
	_set_blood(1)
	GameState.set_flag(&"roommates_dead", true)
	_set_corpses_watching(true)
	await _wait_until(_player_in_room, 120.0)
	await _wait(1.0)
	_think("THINK_CH1_RETURN")
	await _wait(2.5)
	_think("THINK_CH1_BLOOD")
	await _wait(3.0)
	_think("THINK_CH1_NO_SIGNAL")
	# The General Rules come as the player reaches for the door (or after a while).
	await _wait_until(func() -> bool: return _near_door() or not _player_in_room(), 40.0)
	await _announce(["SPK_CH1_GENERAL_INTRO", "RULE_CH1_GENERAL_1", "RULE_CH1_GENERAL_2",
		"RULE_CH1_GENERAL_3", "RULE_CH1_GENERAL_4", "RULE_CH1_GENERAL_5"])
	for n in range(1, 6):
		RuleSystem.mark_read(StringName("ch1_general_%d" % n))
	# Out in the corridor when the rule lands: back inside first, no trap.
	if not _player_in_room():
		_place_player(Vector3(32.0, 0.05, -1.0))
	_think("THINK_CH1_HAND_OFF")
	await _wait(2.0)


# --- Round 1: 4:05–5:00, locked in, group call -----------------------------------

func _round_1() -> void:
	_begin(&"r1", "04:05")
	_rules_live = true
	_set_blood(1)
	_missions.clear()
	for flag: StringName in [&"network_lost", &"network_restored", &"door_threat", &"door_safe", &"wall_prompt", &"strip_tripped"]:
		GameState.set_flag(flag, false)
	# The flag follows the real latch: a reloaded scene starts unlatched even
	# when the checkpoint was saved latched.
	var latch := _door().find_child("DoorLatch407", true, false) if _door() != null else null
	if latch != null:
		GameState.set_flag(&"door_locked", latch.get("_locked") == true)
	await _wait(8.0)
	_think("THINK_CH1_WALL")
	await _wait(10.0)
	_set_clock("04:10")
	await _incoming_call()
	await _line("n_hello")
	await _line("n_how")
	await _choice(&"intro", 2)
	await _line("n_together")
	for member in MEMBERS:
		EventBus.chat_member_changed.emit(member, &"joined")
		await _wait(0.6)
	_set_clock("04:12")
	for id in ["hung_joke", "dang_angry", "bao_cry", "son_quiet", "kiet_ask", "tung_go", "n_stop", "tung_out"]:
		await _line(id)
	_member_dies(&"tung", Vector3(20.0, -9.9, 1.5))
	await _wait(1.5)
	await _line("hung_shaken")
	_think("THINK_CH1_RULE_REAL")
	await _wait(6.0)
	_set_clock("04:18")
	await _line("n_battery")
	_set_battery(18.0)
	_think("THINK_CH1_LOW_BATTERY")
	# N1: Đạt's locker (done when solved).
	_missions[&"locker"] = GameState.get_flag(&"has_charger", false) == true
	await _gap(90.0)
	# N2: the network goes down.
	_set_clock("04:28")
	_network_down()
	await _gap(30.0)
	# N4: a voice at the door, then the handle.
	_set_clock("04:35")
	await _hold_the_door()
	if _dying:
		return
	await _gap(15.0)
	# N3: Khoa knocks from 406.
	_set_clock("04:38")
	await _wall_taps()
	# Minh Nhật brings the network back himself if the player has not.
	await _wait_until(func() -> bool: return _network_up, maxf(OUTAGE_SECONDS - 60.0, 1.0))
	if not _network_up:
		_set_clock("04:48")
		_network_restored(true)
	await _gap(20.0)
	_set_clock("04:50")
	await _line("n_theory")
	await _choice(&"words", 2)
	await _line("n_words_reply")
	await _gap(20.0)
	_set_clock("05:00")
	await _announce(["SPK_CH1_R1_END"])
	_survivors(SURVIVORS_R1)
	await _line("son_352")


func _hold_the_door() -> void:
	_missions[&"door"] = false
	_door_held = false
	_play_knock()
	await _room_line("ROOM_CH1_KNOCK_VIET", 4.5)
	# The handle twists: latch within DOOR_HOLD_SECONDS or be dragged out.
	var door := _door()
	GameState.set_flag(&"door_threat", true)
	if door != null and door.has_method("rattle"):
		door.rattle(DOOR_HOLD_SECONDS)
	var mission := get_parent().get_node_or_null("MissionAudio") if get_parent() else null
	if mission != null and mission.has_method("set_handle_rattling"):
		mission.set_handle_rattling(true)
	await _wait_until(func() -> bool: return GameState.get_flag(&"door_locked", false) == true, DOOR_HOLD_SECONDS)
	if door != null and door.has_method("stop_rattle"):
		door.stop_rattle()
	if mission != null and mission.has_method("set_handle_rattling"):
		mission.set_handle_rattling(false)
	if GameState.get_flag(&"door_locked", false) != true:
		_open_door()
		_die(&"DEATH_DRAGGED_OUT")
		return
	_door_held = true
	_missions[&"door"] = true
	GameState.set_flag(&"door_safe", true)
	await _room_line("ROOM_CH1_KNOCK_VIET_2", 3.5)
	await _line("vinh_ask")
	await _line("n_dont_open")


