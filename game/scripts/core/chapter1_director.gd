func _read_reduce_scares() -> void:
	var config := ConfigFile.new()
	var value: Variant = false
	if config.load("user://settings.cfg") == OK:
		value = config.get_value("accessibility", "reduce_scares", false)
	reduce_scares = value if value is bool else false


func _wait(seconds: float) -> void:
	await _stay()
	await get_tree().create_timer(maxf(seconds * time_scale, 0.0), false).timeout
	await _stay()


## Waits until condition() is true or max_seconds pass (scaled). Pausable.
func _wait_until(condition: Callable, max_seconds: float, scaled: bool = true) -> void:
	var limit := maxf(max_seconds * (time_scale if scaled else 1.0), 0.0)
	var elapsed := 0.0
	while not condition.call() and elapsed < limit:
		await _stay()
		await get_tree().process_frame
		# The scene may have been replaced during the frame (reload, title).
		await _stay()
		if not get_tree().paused:
			elapsed += get_process_delta_time()


func _with_timeout(sig: Signal, max_seconds: float, scaled: bool = true) -> void:
	var done := [false]
	var mark := func(_a: Variant = null, _b: Variant = null) -> void: done[0] = true
	sig.connect(mark, CONNECT_ONE_SHOT)
	await _wait_until(func() -> bool: return done[0], max_seconds, scaled)
	if sig.is_connected(mark):
		sig.disconnect(mark)


## Once the scene leaves the tree (reload, title) park the coroutine; it is
## freed with the node.
func _stay() -> void:
	if not is_inside_tree():
		await tree_entered


func _build_overlay() -> void:
	var layer := CanvasLayer.new()
	layer.name = "DeathLayer"
	layer.layer = 18 # Above HUD (10) and reading views (15), below the pause menu (20).
	add_child(layer)
	_overlay = ColorRect.new()
	_overlay.name = "DeathCard"
	_overlay.visible = false
	_overlay.color = Color(0, 0, 0, 0)
	_overlay.mouse_filter = Control.MOUSE_FILTER_IGNORE
	_overlay.set_anchors_preset(Control.PRESET_FULL_RECT)
	layer.add_child(_overlay)
	var center := CenterContainer.new()
	center.set_anchors_preset(Control.PRESET_FULL_RECT)
	center.mouse_filter = Control.MOUSE_FILTER_IGNORE
	_overlay.add_child(center)
	var lines := VBoxContainer.new()
	lines.add_theme_constant_override("separation", 24)
	center.add_child(lines)
	_overlay_label = Label.new()
	_overlay_label.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
	_overlay_label.add_theme_font_size_override("font_size", 48)
	_overlay_label.add_theme_color_override("font_color", Color(0.75, 0.08, 0.06))
	lines.add_child(_overlay_label)
	_overlay_why = Label.new()
	_overlay_why.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
	_overlay_why.autowrap_mode = TextServer.AUTOWRAP_WORD_SMART
	_overlay_why.custom_minimum_size.x = 900.0
	_overlay_why.add_theme_font_size_override("font_size", 26)
	lines.add_child(_overlay_why)
	_overlay_count = Label.new()
	_overlay_count.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
	_overlay_count.add_theme_font_size_override("font_size", 22)
	_overlay_count.modulate = Color(1, 1, 1, 0.7)
	lines.add_child(_overlay_count)


func _fade_to_black(seconds: float) -> void:
	_overlay.visible = true
	var tween := create_tween()
	tween.tween_property(_overlay, "color:a", 1.0, maxf(seconds * time_scale, 0.01))
	await tween.finished


func _show_card(title_key: String, why_key: String = "", survivors: int = -1) -> void:
	_overlay_label.text = title_key
	_overlay_why.text = why_key
	_overlay_count.text = tr("UI_CH1_SURVIVORS") % survivors if survivors >= 0 else ""
