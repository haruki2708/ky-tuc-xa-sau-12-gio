    {
      "key": "SPK_CH1_GENERAL_INTRO",
      "who": "loa",
      "text": "Toàn thể sinh viên chú ý. Sau đây là Tổng tắc của ký túc xá.",
      "file": "game/audio/voice/vi/SPK_CH1_GENERAL_INTRO.ogg",
      "seconds": 5.461,
      "lufs": -26.11,
      "true_peak_db": -7.35,
      "sha256": "b3c333f444edfd630383c7680074b96313240085d93bcee52ad0b0dfcb0e73c0"
    },
    {
      "key": "RULE_CH1_GENERAL_1",
      "who": "loa",
      "text": "Mọi quy tắc phải được nghe rõ và làm đúng. Ai vi phạm sẽ chết ngay tại chỗ.",
      "file": "game/audio/voice/vi/RULE_CH1_GENERAL_1.ogg",
      "seconds": 6.265,
      "lufs": -26.14,
      "true_peak_db": -8.11,
      "sha256": "e3eedddf8d32c091fe942cbc619194a9ac4f74b2f914dbe6b544aa93f5ab22ba"
    },
    {
      "key": "RULE_CH1_GENERAL_2",
      "who": "loa",
      "text": "Khi quy tắc mới được công bố, quy tắc cũ hết hiệu lực. Không có quy tắc nào lặp lại.",
      "file": "game/audio/voice/vi/RULE_CH1_GENERAL_2.ogg",
      "seconds": 7.184,
      "lufs": -26.11,
      "true_peak_db": -7.25,
      "sha256": "2d973b294d3467021bdcfa425b6858e31bcd550ab4d2875cfe2e30085c00db45"
    },
    {
      "key": "RULE_CH1_GENERAL_3",
      "who": "loa",
      "text": "Không sinh viên nào được rời khỏi phòng của mình. Ai rời phòng sẽ chết.",
      "file": "game/audio/voice/vi/RULE_CH1_GENERAL_3.ogg",
      "seconds": 5.46,
      "lufs": -26.11,
      "true_peak_db": -7.02,
      "sha256": "d256714947e9516014fa1c5be6a39e43e71ce36937086942f5cf9b17e38449ee"
    },
    {
      "key": "RULE_CH1_GENERAL_4",
      "who": "loa",
      "text": "Không được tấn công quản lý ký túc xá, bảo vệ hay bất kỳ nhân viên nào.",
      "file": "game/audio/voice/vi/RULE_CH1_GENERAL_4.ogg",
      "seconds": 5.901,
      "lufs": -26.13,
      "true_peak_db": -8.2,
      "sha256": "dda37f8a6e89c63ea673672aa30249303b14e540cf6aa3245958d25262712ad9"
    },
    {
      "key": "RULE_CH1_GENERAL_5",
      "who": "loa",
      "text": "Mỗi giờ sẽ có một quy tắc mới, trong năm giờ. Ai còn sống đến cuối cùng sẽ được rời đi an toàn.",
      "file": "game/audio/voice/vi/RULE_CH1_GENERAL_5.ogg",
      "seconds": 8.138,
      "lufs": -26.11,
      "true_peak_db": -7.52,
      "sha256": "cda5780b0605416ca216ce773253b27dd1fbe13f5950d57044767e9dd9e598e9"
    },
    {
      "key": "CHAT_CH1_N_HELLO",
