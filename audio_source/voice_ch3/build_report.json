    {
      "key": "ROOM_CH3_TV_NEWS",
      "who": "tv",
      "text": "Tin khẩn. Lúc bốn giờ sáng nay, một trận động đất mạnh đã xảy ra. Các tòa ký túc xá của trường đổ sập hoàn toàn. Lực lượng cứu hộ đang đào bới, tìm người còn sống dưới đống đổ nát.",
      "file": "game/audio/voice/vi/ROOM_CH3_TV_NEWS.ogg",
      "seconds": 12.455,
      "lufs": -29.09,
      "true_peak_db": -11.05,
