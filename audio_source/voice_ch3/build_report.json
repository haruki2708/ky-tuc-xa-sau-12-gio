    {
      "key": "NEAR_CH3_N_NO_WAY",
      "who": "minh_nhat",
      "text": "Họ chặn kín cổng rồi. Lối này không ra được.",
      "file": "game/audio/voice/vi/NEAR_CH3_N_NO_WAY.ogg",
      "seconds": 2.684,
