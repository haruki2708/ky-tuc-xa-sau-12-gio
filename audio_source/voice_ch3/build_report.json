  "assets": [
    {
      "key": "SPK_CH3_R5_INTRO",
      "who": "loa",
      "text": "Vòng cuối cùng bắt đầu. Nhà trường quyết định nới lỏng yêu cầu.",
      "file": "game/audio/voice/vi/SPK_CH3_R5_INTRO.ogg",
      "seconds": 4.63,
