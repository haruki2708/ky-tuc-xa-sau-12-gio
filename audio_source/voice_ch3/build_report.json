    },
    {
      "key": "NEAR_CH3_N_SPLIT",
      "who": "minh_nhat",
      "text": "Chia nhau ra. Ngư qua khu giảng đường, tôi qua nhà thi đấu, Trung qua thư viện. Thấy gì lạ thì gọi ngay.",
