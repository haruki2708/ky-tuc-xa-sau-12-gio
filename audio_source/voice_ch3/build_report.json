    },
    {
      "key": "RULE_CH3_R5_1",
      "who": "loa",
      "text": "Các bạn được phép rời phòng, đi lại ở mọi khu vực trong trường.",
      "file": "game/audio/voice/vi/RULE_CH3_R5_1.ogg",
      "seconds": 4.957,
      "lufs": -26.14,
      "true_peak_db": -6.5,
      "sha256": "82d558b9f97f90e31040454ebbd1975b468f5b7d771378fb9764a38454d82b75"
    },
    {
      "key": "RULE_CH3_R5_2",
      "who": "loa",
      "text": "Hãy mau chạy khỏi góc khuất nguy hiểm này.",
      "file": "game/audio/voice/vi/RULE_CH3_R5_2.ogg",
      "seconds": 3.038,
      "lufs": -26.14,
      "true_peak_db": -6.54,
      "sha256": "6c17e0ee76018dc281408c109c74945261ac42ef14b0dbc4023808cb91d39bab"
    },
    {
      "key": "RULE_CH3_R5_3",
      "who": "loa",
      "text": "Nhiệm vụ rất đơn giản: trong một giờ cuối cùng, tránh mọi sự truy sát và sống sót.",
      "file": "game/audio/voice/vi/RULE_CH3_R5_3.ogg",
      "seconds": 6.753,
      "lufs": -26.13,
      "true_peak_db": -6.16,
      "sha256": "1813b224781dca51a39d8e388f0825749808cb77a3f8af65f931fab236fe20d8"
    },
    {
      "key": "CHAT_CH3_N_ALL_UP",
      "who": "minh_nhat",
      "text": "Chúng nó đứng dậy hết rồi! Cả tòa… hành lang chỗ tôi toàn người, mắt đỏ lòm.",
      "file": "game/audio/voice/vi/CHAT_CH3_N_ALL_UP.ogg",
      "seconds": 4.65,
      "lufs": -26.15,
      "true_peak_db": -4.81,
      "sha256": "d70cdb05d2cbebb078aad0309ece73e22f33d46fbab6faa242f75916826fe449"
    },
    {
      "key": "CHAT_CH3_N_OUT",
      "who": "minh_nhat",
      "text": "Luật cấm rời phòng bị bỏ rồi. Ba đứa mình phải ra ngoài, gặp nhau.",
      "file": "game/audio/voice/vi/CHAT_CH3_N_OUT.ogg",
      "seconds": 3.89,
      "lufs": -26.12,
      "true_peak_db": -4.82,
      "sha256": "2bf17253000143c4d9f5dae08800d71bcbe91e0e28de432728f484da12ff5a80"
    },
    {
      "key": "CHAT_CH3_NGU_GARDEN",
      "who": "ngu",
      "text": "Vườn hoa giữa nhà A với nhà B. Gặp ở đó. Chúng nó chậm lắm, đừng để bị dồn vào chỗ hẹp là được.",
      "file": "game/audio/voice/vi/CHAT_CH3_NGU_GARDEN.ogg",
      "seconds": 5.843,
      "lufs": -26.01,
      "true_peak_db": -8.52,
      "sha256": "26ce4fd1dc511cd91d44e84a5f2c3afffdffc253f4e76bb4d89188225caae691"
    },
    {
      "key": "CHAT_CH3_N_TRAPPED",
      "who": "minh_nhat",
      "text": "Trung, cậu đang ở đâu? Tôi kẹt trong 203, chúng nó đang đập cửa!",
      "file": "game/audio/voice/vi/CHAT_CH3_N_TRAPPED.ogg",
      "seconds": 4.316,
      "lufs": -26.14,
      "true_peak_db": -4.02,
      "sha256": "eba5b264de8419672400b67c7623c223d56de98cdcb0fd2852768d384cf9c037"
    },
    {
      "key": "NEAR_CH3_N_JOIN",
      "who": "minh_nhat",
      "text": "Cảm ơn… Cầu thang chính, bên trái. Lúc nãy tôi thấy chỗ đó vãn rồi.",
      "file": "game/audio/voice/vi/NEAR_CH3_N_JOIN.ogg",
      "seconds": 4.065,
      "lufs": -26.14,
      "true_peak_db": -4.4,
      "sha256": "697980a9809e86535cff0207104aa98ea4ad873051bccd4f0ec1a9d52443cb4a"
    },
    {
      "key": "NEAR_CH3_N_CHAINED",
      "who": "minh_nhat",
      "text": "Xích từ bên ngoài… Ai khóa chứ?",
      "file": "game/audio/voice/vi/NEAR_CH3_N_CHAINED.ogg",
      "seconds": 2.044,
      "lufs": -26.15,
      "true_peak_db": -5.43,
      "sha256": "c1ea18d38bf9873bfb667ee9f9ceacf9ab1d4d0279eaeabed13a60aa6f183c56"
    },
    {
      "key": "NEAR_CH3_NGU_HERE",
      "who": "ngu",
      "text": "Trung! Minh Nhật! Bên này!",
      "file": "game/audio/voice/vi/NEAR_CH3_NGU_HERE.ogg",
      "seconds": 2.018,
      "lufs": -26.07,
      "true_peak_db": -5.45,
      "sha256": "da5150dde611fa307e132484e8d1246415e194d7e43bff96073c1eab1e05f7c1"
    },
    {
      "key": "NEAR_CH3_NGU_BARS",
      "who": "ngu",
      "text": "Cầm lấy, tháo từ thang giường đấy. Chúng nó chết rồi, không giết lại được đâu. Nhưng đập vào đầu thì nó đứng im một lúc.",
      "file": "game/audio/voice/vi/NEAR_CH3_NGU_BARS.ogg",
      "seconds": 6.357,
      "lufs": -26.06,
      "true_peak_db": -6.69,
      "sha256": "7579b021807d9f8cca7f6ccc73ef1c6eb590c4037c5a34fce4e442018875cb8b"
    },
    {
      "key": "NEAR_CH3_N_STADIUM",
      "who": "minh_nhat",
      "text": "Ra sân vận động. Chỗ đó thoáng nhất, khó bị vây.",
