    },
    {
      "key": "NEAR_CH3_N_NO_DEAD_END",
      "who": "minh_nhat",
      "text": "Khoan. Vòng nào luật cũng chừa một đường sống. Không thể bắt mình chạy mãi thế này được. Đường sống phải ở đâu đó trong trường.",
      "file": "game/audio/voice/vi/NEAR_CH3_N_NO_DEAD_END.ogg",
      "seconds": 6.531,
      "lufs": -26.15,
      "true_peak_db": -4.1,
      "sha256": "14f61f68ab67f6930bf9057b24be789c6ac1b2578e6f3c62d5cc7609d933ded0"
    },
    {
      "key": "NEAR_CH3_NGU_GATE",
      "who": "ngu",
      "text": "Thì đi tìm. Ra cổng trường trước.",
      "file": "game/audio/voice/vi/NEAR_CH3_NGU_GATE.ogg",
