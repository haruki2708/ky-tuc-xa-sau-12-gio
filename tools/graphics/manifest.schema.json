{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "T-210 static asset G1 proposal",
  "type": "object",
  "required": [
    "schema_version",
    "assets"
  ],
  "properties": {
    "schema_version": {
      "const": "t210-g1-static-1"
    },
    "assets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/asset"
      }
    }
  },
  "$defs": {
    "asset": {
      "type": "object",
      "required": [
        "asset_id",
        "scope",
        "file",
        "source",
        "geometry",
        "generation",
        "budget",
        "approval",
        "binding",
        "placement"
      ],
      "properties": {
        "asset_id": {
          "type": "string",
          "minLength": 1
        },
        "scope": {
          "enum": [
            "prototype",
            "production"
          ]
        },
        "file": {
          "type": "string",
          "minLength": 1
        },
        "planned_route": {
          "type": "string"
        },
        "source": {
          "type": "object",
          "required": [
            "uri",
            "author",
            "license",
            "credits_file",
            "ai_tool",
            "input_rights"
          ],
          "properties": {
            "uri": {
              "type": "string",
              "minLength": 1
            },
            "author": {
              "type": "string",
              "minLength": 1
            },
            "license": {
              "type": "string",
              "minLength": 1
            },
            "credits_file": {
              "type": "string",
              "minLength": 1
            },
            "ai_tool": {
              "type": "string",
              "minLength": 1
            },
            "input_rights": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "geometry": {
          "type": "object",
          "required": [
            "dimensions_m",
            "bounds_min_m",
            "root_scale",
            "markers",
            "coordinate_space",
            "pose",
            "visibility_policy"
          ],
          "properties": {
            "dimensions_m": {
              "type": "array",
              "items": {
                "type": "number"
              },
              "minItems": 3,
              "maxItems": 3
            },
            "bounds_min_m": {
              "type": "array",
              "items": {
                "type": "number"
              },
              "minItems": 3,
              "maxItems": 3
            },
            "root_scale": {
              "type": "array",
              "items": {
                "type": "number",
                "minimum": 0.99999,
                "maximum": 1.00001
              },
              "minItems": 3,
              "maxItems": 3
            },
            "markers": {
              "type": "object",
              "additionalProperties": {
                "type": "array",
                "items": {
                  "type": "number"
                },
                "minItems": 3,
                "maxItems": 3
              }
            },
            "coordinate_space": {
              "const": "selected_root_local"
            },
            "pose": {
              "const": "rest"
            },
            "visibility_policy": {
              "const": "include_hidden"
            },
            "tolerance_m": {
              "type": "number",
              "minimum": 0,
              "default": 0.001
            }
          }
        },
        "generation": {
          "type": "object",
          "required": [
            "tool",
            "provider",
            "channel",
            "wallet_id",
            "tier",
            "model_version",
            "model_id",
            "task_id",
            "created_on",
            "parameters",
            "rights_evidence"
          ],
          "properties": {
            "provider": {
              "enum": [
                "self_authored",
                "tripo",
                "meshy"
              ]
            },
            "channel": {
              "enum": [
                "local",
                "studio",
                "api"
              ]
            },
            "rights_evidence": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "tool": {
              "type": "string",
              "minLength": 1
            },
            "wallet_id": {
              "type": [
                "string",
                "null"
              ]
            },
            "model_version": {
              "type": [
                "string",
                "null"
              ]
            },
            "model_id": {
              "type": [
                "string",
                "null"
              ]
            },
            "task_id": {
              "type": [
                "string",
                "null"
              ]
            },
            "created_on": {
              "type": [
                "string",
                "null"
              ]
            },
            "tier": {
              "enum": [
                null,
                "unknown",
                "free",
                "paid"
              ]
            },
            "parameters": {
              "type": "object",
              "additionalProperties": {
                "$ref": "#/$defs/jsonValue"
              }
            }
          }
        },
        "budget": {
          "type": "object",
          "required": [
            "estimated_credits",
            "consumed_credits",
            "wallet_id",
            "balance_before",
            "balance_after",
            "triangle_limit_exclusive",
            "material_limit",
            "texture_edge_limit",
            "basis"
          ],
          "properties": {
            "estimated_credits": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0
            },
            "consumed_credits": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0
            },
            "balance_before": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0
            },
            "balance_after": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0
            },
            "wallet_id": {
              "type": [
                "string",
                "null"
              ]
            },
            "basis": {
              "type": "string",
              "minLength": 1
            },
            "triangle_limit_exclusive": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 1
            },
            "material_limit": {
              "type": "integer",
              "minimum": 1
            },
            "texture_edge_limit": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "approval": {
          "type": "object",
          "required": [
            "status",
            "reviewer"
          ],
          "properties": {
            "status": {
              "enum": [
                "pending",
                "approved",
                "rejected"
              ]
            },
            "reviewer": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        },
        "binding": {
          "type": "object",
          "required": [
            "scene_path",
            "node_path",
            "root_class",
            "required_markers",
            "collider_policy"
          ],
          "properties": {
            "collider_policy": {
              "const": "preserve_gameplay"
            },
            "required_markers": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "scene_path": {
              "type": "string",
              "minLength": 1
            },
            "node_path": {
              "type": "string",
              "minLength": 1
            },
            "root_class": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "placement": {
          "type": "object",
          "required": [
            "position_m",
            "rotation_degrees",
            "scale"
          ],
          "properties": {
            "position_m": {
              "type": "array",
              "items": {
                "type": "number"
              },
              "minItems": 3,
              "maxItems": 3
            },
            "rotation_degrees": {
              "type": "array",
              "items": {
                "type": "number"
              },
              "minItems": 3,
              "maxItems": 3
            },
            "scale": {
              "type": "array",
              "items": {
                "type": "number"
              },
              "minItems": 3,
              "maxItems": 3
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "asset_id": {
                "const": "room407_backpack"
              }
            },
            "required": [
              "asset_id"
            ]
          },
          "then": {
            "properties": {
              "geometry": {
                "properties": {
                  "tolerance_m": {
                    "maximum": 0.001
                  }
                }
              },
              "budget": {
                "properties": {
                  "triangle_limit_exclusive": {
                    "type": "integer",
                    "maximum": 3001
                  },
                  "material_limit": {
                    "maximum": 2
                  },
                  "texture_edge_limit": {
                    "maximum": 1024
                  }
                }
              }
            }
          }
        }
      ]
    },
    "jsonValue": {
      "anyOf": [
        {
          "type": [
            "string",
            "number",
            "boolean",
            "null"
          ]
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/jsonValue"
          }
        },
        {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/jsonValue"
          }
        }
      ]
    }
  }
}
